 "cw_ready_half_death": {
  "credits": 0.5,
  "endpoint": "/assets/image/edit",
  "file": "assets/_concept/candlewake/candidates/claude/ready_half_death.webp",
  "history": [
   {
    "credits": 0.5,
    "endpoint": "/assets/image/edit",
    "job": "35a6dca4-b759-470a-a31e-ef1e7a319cef",
    "url": "https://storage.googleapis.com/ludo-assets/api/67bc3b2c14195d97f091c904c76aa295.webp",
    "v": 1
   }
  ],
  "id": "cw_ready_half_death",
  "job": "0c2df82b-7bab-46e5-840f-e4f8d46250e0",
  "params": {
   "augment_prompt": false,
   "image": "data:image/png;base64,iVBORw0KGgoAAAANSU...(base64)",
   "n": 1,
   "prompt": "Keep only the tall pale god in the tattered ivory robes on the left, exactly as drawn: the same long bald head, one half of the face smooth pale alabaster with a closed eye, the other half an empty lilac outline with darkness through it, the same soot-black high collar, tattered ivory robes over black, lilac sash and brass-buckled belt, soot-black hands, the same dark crooked staff with the brass lantern of lilac flame hanging from it. He stands tall in a calm ready stance, the staff held upright at arm's length with clear space between the staff and his body, his other hand held a little out from his side with the fingers open. Three-quarter view from slightly above, the whole figure centred with wide empty margin on every side and clear headroom, the same painted cel style with thick clean dark outlines, flat colours with one shadow tone and one highlight, matte finish, even soft light from the front, plain flat light grey background everywhere else."
  },
  "url": "https://storage.googleapis.com/ludo-assets/api/ac8e295284a0c159d850eb9fd2f284aa.webp",
  "v": 2
 },
 "cw_ready_lamplighter": {
  "credits": 0.5,
  "endpoint": "/assets/image/edit",
  "file": "assets/_concept/candlewake/candidates/claude/ready_lamplighter.webp",
  "history": [
   {
    "credits": 0.5,
    "endpoint": "/assets/image/edit",
    "job": "5c2f2658-5bfc-4624-8cf4-ea1bb8a5e64e",
    "url": "https://storage.googleapis.com/ludo-assets/api/1c3ef3596fc9f08fe859823e6d11d35c.webp",
