   }
  ],
  "id": "cw_ready_lamplighter",
  "job": "5a1c073f-bed4-4722-9ecd-85e864552dee",
  "params": {
   "augment_prompt": false,
   "image": "data:image/png;base64,iVBORw0KGgoAAAANSU...(base64)",
   "n": 1,
   "prompt": "Keep only the tall cloaked figure holding the very tall brass lantern pole, exactly as drawn: the same pale wax hood around a black hollow face with lilac light inside, the same short black wick stub on top of the head, bare and unlit, the same tall black high-collared cloak lined in plum with lilac edges, lilac bow at the throat, brass buckles and belts, the same very tall brass pole topped by a lantern of lilac flame. He stands in a stern ready stance with his feet apart, the pole held upright at arm's length with clear space between the pole and his body and cloak, the lantern rising well above his head, his other arm held a little away from his side. Three-quarter view from slightly above, the whole figure centred with wide empty margin on every side and clear headroom, the same painted cel style with thick clean dark outlines, flat colours with one shadow tone and one highlight, matte finish, even soft light from the front, plain flat light grey background everywhere else."
  },
  "url": "https://storage.googleapis.com/ludo-assets/api/c8887e89495e8aeaefedde177333c5c5.webp",
  "v": 2
 },
