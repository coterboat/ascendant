# Godot 4 editor/import cache
.godot/
.import/
*.translation

# Export output
build/
*.tmp

# Editor / OS noise
*.swp
*~
.DS_Store
Thumbs.db

# Asset pipeline (#10): candidates and masters stay local, never committed
**/candidates/
__pycache__/
*.pyc

# Secrets (LUDO_API_KEY lives in .env / .env.local)
.env*

# Local worktrees made by Claude Code sessions
.claude/worktrees/

# Review Table (#150): batches and their media stay local; review/.gdignore stays tracked
review/*/

# What `review.py canon` writes for the demo batch and for the tool's own tests (the real canon is committed)
assets/_concept/lore/sample_*/
assets/_concept/lore/zz_test_*/
